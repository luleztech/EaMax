<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Media3 controller only (no full-screen touch catcher). Time labels via SupasokaPlayerOverlay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_bottom_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/player_controls_scrim"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <ImageButton
        android:id="@+id/exo_play_pause"
        style="@style/ExoMediaButton.Play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/player_play_pause" />

    <TextView
        android:id="@+id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="monospace"
        android:minWidth="40dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        app:bar_height="3dp"
        app:buffered_color="#66FFFFFF"
        app:played_color="#2196F3"
        app:scrubber_color="#2196F3"
        app:unplayed_color="#33FFFFFF" />

    <TextView
        android:id="@+id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:minWidth="40dp"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/eamax_live_badge_inline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/live_badge_background"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/player_live"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

  <ImageButton
        android:id="@+id/btn_exo_player_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/player_toolbar_button_bg"
        android:contentDescription="@string/player_settings"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_player_settings" />
</LinearLayout>
